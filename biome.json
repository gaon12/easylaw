{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!data",
      "!drizzle",
      "!src/app/fonts.css",
      "!public/fonts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": "on",
      "complexity": "on",
      "correctness": "on",
      "performance": "on",
      "security": "on",
      "style": "on",
      "suspicious": "on",
      "nursery": "off"
    },
    "domains": {
      "next": "all",
      "react": "all",
      "test": "all",
      "project": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          },
          "performance": {
            "useSolidForComponent": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "correctness": {
            "noUnresolvedImports": "off",
            "useImportExtensions": "off",
            "useQwikValidLexicalScope": "off"
          },
          "style": {
            "useNamingConvention": {
              "level": "on",
              "options": {
                "conventions": [
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
                  },
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["*.config.ts", "*.config.mts", "next.config.ts", "scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          },
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off",
            "useExportsLast": "off",
            "noMagicNumbers": "off",
            "useNumericSeparators": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
