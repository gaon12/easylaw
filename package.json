{
  "name": "easylaw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config drizzle.corpus.config.ts && drizzle-kit generate --config drizzle.app.config.ts && drizzle-kit generate --config drizzle.dict.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "law:sync": "tsx scripts/sync-laws.ts",
    "llm:mock": "tsx scripts/mock-llm.ts",
    "gen:try": "tsx --conditions=react-server scripts/generate-once.ts",
    "case:example": "tsx --conditions=react-server scripts/seed-case-example.ts",
    "dict:sync": "tsx --conditions=react-server scripts/sync-dict.ts",
    "tts:mock": "tsx scripts/mock-tts.ts",
    "browser-support:generate": "node scripts/generate-browser-support.mjs",
    "browser-support:check": "node scripts/generate-browser-support.mjs --check",
    "prebuild": "npm run browser-support:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dicebear/core": "9.4.3",
    "@dicebear/identicon": "9.4.2",
    "better-sqlite3": "^13.0.3",
    "braillify": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "es-hangul": "^2.4.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.3",
    "openai": "^7.10.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "thumbhash": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "^4.28.9",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
