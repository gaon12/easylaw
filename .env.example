# EasyLaw 환경변수
#
# 여기에는 **데이터베이스를 열기 전에 알아야 하는 값만** 둔다.
# 법제처 인증키·LLM 연결·생성 상한 같은 설정은 환경변수가 아니라 데이터베이스에 있고,
# 처음 서버를 띄운 뒤 /setup 설치 마법사에서 넣는다. 나중에 관리자 화면에서 바꿀 수 있다.
#
# 이 파일을 .env로 복사해서 쓴다. .env는 커밋되지 않는다.

# 서버가 열리는 포트. Next가 직접 읽는다. 비워 두면 3000.
PORT=3000

# 데이터베이스 파일 경로. 두 파일은 반드시 서로 달라야 한다 —
# 공개 판례와 사용자가 올린 문서를 파일 단계에서 분리하기 위해서다(PRODUCT.md §6.1).
CORPUS_DB_PATH=data/corpus.sqlite
APP_DB_PATH=data/app.sqlite
