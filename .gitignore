# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일은 올린다 — 무엇을 넣어야 하는지 알려면 필요하다. 값은 들어 있지 않다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev docs
/.dev/

# 로컬 데이터 — 절대 커밋하지 않는다.
# 판결문 원문·업로드 문서·마스킹 전 텍스트가 들어 있다. 한 번 올라가면 히스토리에서 지우기 어렵다.
/data/
/uploads/
# 경로를 옮겨도(CORPUS_DB_PATH·APP_DB_PATH) 확장자로 한 번 더 막는다.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
